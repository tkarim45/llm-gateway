# llm-gateway — copy to `.env` and fill in. `.env` is gitignored.
# The gateway's upstreams: AWS Bedrock (primary) and/or the Anthropic API (secondary).

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_PROFILE=default
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# ── Anthropic API (optional failover secondary) ───────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Gateway config (optional overrides) ───────────────────────────────────────
# GATEWAY_PROVIDERS=bedrock,anthropic       # ordered failover chain
# GATEWAY_BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# GATEWAY_TENANTS_FILE=tenants.json         # [{tenant_id, api_key, rate_limit_rps, burst, token_quota}]
# GATEWAY_AUDIT_PATH=audit.log.jsonl
# GATEWAY_PRICE_IN=1.0                      # USD per 1M input tokens (metering)
# GATEWAY_PRICE_OUT=5.0
